#!/usr/bin/env ruby
$stdout.sync = true
require_relative "../boot"

state = SyncState.new
writers = TokenPool.new(prefix: "SLACK_WRITER_TOKEN", rate: 30)
readers = TokenPool.new(prefix: "SLACK_READER_TOKEN", rate: 50)

puts "streetcreditor seed"
puts "  #{writers.size} writer tokens, #{readers.size} reader tokens"

config = Pipeline.load_config
puts "  #{config[:aliases].size} email aliases, #{config[:overrides].size} manual overrides"

puts "loading approved projects (streaming)..."
latest = {}
count = 0
ApprovedProject.all.each do |project|
  email = Pipeline.canonicalize(project.email_normalized || project.email, config[:aliases])
  next unless email && !email.empty?
  date = project.approved_at
  next unless date
  latest[email] = date if !latest[email] || date > latest[email]
  count += 1
  print "  #{count} projects...\r" if count % 100 == 0
end

config[:overrides].each do |email, date|
  next unless email && date
  latest[email] = date if !latest[email] || date > latest[email]
end

puts "  #{count} projects -> #{latest.size} unique shippers"

changes = Pipeline.diff(latest, state)
puts "  #{changes.size} profiles to update"

Pipeline.resolve_slack_ids!(changes, readers, state)
puts "  #{changes.size} resolved to Slack users"

result = Pipeline.push_to_slack!(changes, writers, state)
state.touch_sweep!

puts "done! #{result[:success]} updated, #{result[:errors]} errors"
