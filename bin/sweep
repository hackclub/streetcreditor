#!/usr/bin/env ruby
$stdout.sync = true
require_relative "../boot"

# incremental sync + alt-text refresh + webhook keepalive.
# the logic lives in lib/sweep.rb so the webhook server can run it in-process too
# (where the /data volume is actually mounted — an orchard job pod can't).
Sweep.run(
  state:   SyncState.new,
  writers: TokenPool.new(prefix: "SLACK_WRITER_TOKEN", rate: 45),
  readers: TokenPool.new(prefix: "SLACK_READER_TOKEN", rate: 45)
)
